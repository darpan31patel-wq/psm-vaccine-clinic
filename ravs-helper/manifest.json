{
  "manifest_version": 3,
  "name": "PSM RAVS Helper",
  "version": "0.5.4",
  "description": "Fills in Record a vaccination (RAVS) pages from the PSM Vaccine Clinic app. Staff check every page and press Confirm and save themselves.",
  "permissions": ["storage"],
  "host_permissions": ["https://ravs.england.nhs.uk/*", "https://www.ravs.england.nhs.uk/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://ravs.england.nhs.uk/*", "https://www.ravs.england.nhs.uk/*"],
      "js": ["ravs.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.googleusercontent.com/*"],
      "js": ["app-bridge.js"],
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true,
      "run_at": "document_idle"
    }
  ]
}
